{
  "name": "rasoios",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:http": "node scripts/http-smoke.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:import-mendeley": "tsx scripts/import-mendeley.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed && npm run db:import-mendeley",
    "format": "prettier --write src prisma/seed.ts tests scripts *.json *.mjs *.mts README.md"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@prisma/client": "6.19.0",
    "decimal.js": "10.6.0",
    "groq-sdk": "^1.6.0",
    "lucide-react": "0.468.0",
    "next": "16.4.2",
    "openai": "7.34.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.18.6",
    "@types/react": "19.0.6",
    "@types/react-dom": "19.0.3",
    "dotenv": "16.4.7",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "effect": "3.20.0",
    "deepmerge-ts": "8.0.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.14"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
